# Copie este arquivo para .env.local para configurar o ambiente local.
# Nunca versione .env.local nem coloque segredos em variáveis NEXT_PUBLIC_*.
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Opcional: endpoint de backend autenticado para geração de quizzes.
# O endpoint deve validar sessão, assinatura e limite semanal no servidor.
# Não use a URL de um provedor de IA diretamente no frontend.
# NEXT_PUBLIC_QUIZ_API_URL=https://seu-dominio.com.br/api/quiz
